{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      // Хостинговый MCP-сервер Render. OAuth отключён: сервер авторизации
      // Render (https://api.render.com) не поддерживает динамическую регистрацию
      // клиента, поэтому используется API-ключ.
      //
      // Ключ лежит в файле вне репозитория, чтобы не попасть в git.
      // Положи туда только сам ключ (rnd_...), без кавычек и префикса Bearer.
      "render": {
        "type": "remote",
        "url": "https://mcp.render.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/secrets/render_api_key}",
        },
      },
    },
  },
}
